}

# Escape for a form: style ("dart" for a normal dash), name and why
static func get_escape(data: Dictionary) -> Array:
    return ESCAPES.get(data.get("id", ""), ["dart", "Dash", "darts away"])

static func escape_label(data: Dictionary) -> String:
    var style = get_escape(data)[0]
    return ESCAPE_STYLES[style].label if ESCAPE_STYLES.has(style) else "DASH"

static func weapon_stats(weapon: String) -> Dictionary:
    return WEAPONS.get(weapon, WEAPONS["vesicle"])

static func path_key(choices: Array) -> String:
    var parts: Array = []
    for c in choices:
        parts.append(str(c))
    return ",".join(parts)

static func has_form(path: String) -> bool:
    return TREE.has(path)

static func get_form(path: String) -> Dictionary:
    return TREE.get(path, {})

# Paths of the forms offered after the form at `path`. Empty when no real
# split is known, in which case the game offers an in-clade upgrade.
static func get_child_paths(path: String) -> Array:
    var result: Array = []
    var i = 0
    while true:
        var child = str(i) if path == "" else path + "," + str(i)
        if not TREE.has(child):
            break
        result.append(child)
        i += 1
    return result

# Plain-language summary of a form's stats and perks for the evolution cards.
static func describe_perks(data: Dictionary) -> String:
    var lines: Array = []
    lines.append("Speed %d · Damage %.1f · Fire delay %.2fs" % [int(data.speed), data.damage, data.fire_delay])
    if data.max_health_add > 0:
        lines.append("+%d max health" % data.max_health_add)
    var weapon = weapon_stats(data.get("weapon", "vesicle"))
    var melee = weapon.melee
    lines.append("Attack: %s (%s)" % [data.get("weapon_name", "Engulf (phagocytosis)"), weapon.label])
    if weapon.get("special", "") != "":
        lines.append(weapon.special)
    lines.append(describe_senses(data))
    var attacks = {
        "triple": "Triple-shot spread", "5way": "Five-way spread", "7way": "Seven-way spread",
        "needle": "Rapid needles, every third shot is a piercing strike",
        "boomerang": "Twin boomerang shots", "explosive": "Explosive shots", "piercing": "Piercing shots",
    }
    if attacks.has(data.attack_type) and not melee:
        lines.append(attacks[data.attack_type])
    var tear_text = {
        "piercing": "shots pierce", "electric": "shots chain electricity", "homing": "shots home in",
        "caustic": "venomous shots", "vampiric": "shots drain health", "explosive": "shots explode",
        "shrapnel": "shots burst into shrapnel", "stun": "shots stun", "boomerang": "shots return",
    }
    var tears: Array = []
    for key in data.tear_perks:
        if melee and key in ["piercing", "homing", "shrapnel", "boomerang"]:
            continue
        if tear_text.has(key):
            tears.append(tear_text[key].replace("shots ", "hits ") if melee else tear_text[key])
    if data.tear_perks.has("knockback"):
        tears.append("knockback")
    if not tears.is_empty():
        var tear_line = ", ".join(tears)
        lines.append(tear_line.left(1).to_upper() + tear_line.substr(1))
    var dash_text = {
        "slipstream": "Dash leaves a slipstream", "poison_trail": "Dash leaves a venom trail",
        "smoke_cloud": "Dash releases a cloud", "web_snare": "Dash lays a silk snare",
        "camouflage": "Dash turns you nearly invisible", "seismic": "Dash ends in a seismic stomp",
        "cavitation_burst": "Dash fires a cavitation burst", "rolling_boulder": "Dash rolls you into an armored ball",
    }
    for key in data.dash_perks:
        if dash_text.has(key):
            lines.append(dash_text[key])
    var escape = get_escape(data)
    if escape[0] != "dart":
        lines.append("No dash: %s instead" % escape[1].to_lower())
    if data.dash_perks.has("slam_damage"):
        lines.append("%s hits for %d damage" % ["Dash" if escape[0] == "dart" else escape[1], int(data.dash_perks.slam_damage)])
    var passive_text = {
        "regen": "Regrows health over time", "flight": "Flies over obstacles",
        "retaliatory_spines": "Fires spines when hit", "double_iframes": "Longer invulnerability after hits",
        "damage_reduction": "Takes less damage", "damage_reduction_plus_reflect": "Takes less damage and reflects shots",
    }
    if passive_text.has(data.passive):
        lines.append(passive_text[data.passive])
    return "\n".join(lines)
